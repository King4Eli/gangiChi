<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gangiChi.Messages"
             xmlns:local="clr-namespace:gangiChi"
             BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#101828}"
             Title="Messages">

    <Grid RowDefinitions="*,Auto">
        <CollectionView Grid.Row="0" x:Name="listerbox"
                        VerticalScrollBarVisibility="{OnPlatform WinUI=Always, Default=Default}"
                        HorizontalScrollBarVisibility="Never"
                        Margin="{OnIdiom Phone='8,8,8,0', Default='16,12,16,0'}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="{OnIdiom Phone='4,3', Default='8,4'}">
                        <Border x:Name="bubble" Padding="{OnIdiom Phone='12,8', Default='14,10'}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                MaximumWidthRequest="{OnIdiom Phone=300, Default=560}"
                                HorizontalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D2939}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="Sent">
                                    <Setter Property="HorizontalOptions" Value="End" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="StrokeShape" Value="RoundRectangle 16,16,16,4" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="Received">
                                    <Setter Property="StrokeShape" Value="RoundRectangle 16,16,4,16" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="System">
                                    <Setter Property="HorizontalOptions" Value="Center" />
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter Property="Padding" Value="8,4" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Textstr}" FontSize="{OnIdiom Phone=16, Default=15}" LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#101828, Dark=#F2F4F7}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Sent">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="System">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#667085, Dark=#98A2B3}" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="HorizontalTextAlignment" Value="Center" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Image Source="{Binding Imagestr}" IsVisible="{Binding Imagevisible}" Aspect="AspectFit"
                                       MaximumHeightRequest="{OnIdiom Phone=260, Default=420}">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Image_MouseLeftButtonDown" CommandParameter="{Binding .}"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="1" StrokeThickness="0" Padding="{OnIdiom Phone='8,8', Default='16,12'}"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D2939}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 22" StrokeThickness="1" Padding="12,0"
                        Stroke="{AppThemeBinding Light=#E4E7EC, Dark=#344054}"
                        BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#101828}">
                    <Entry Placeholder="Write a message…" ReturnType="Send" Completed="Sendmessages_Clicked"
                           x:Name="texttosend" AutomationId="composer" BackgroundColor="Transparent" MinimumHeightRequest="44"
                           VerticalOptions="Center" />
                </Border>
                <Button Grid.Column="1" Text="Send" Clicked="Sendmessages_Clicked"
                        CornerRadius="22" MinimumHeightRequest="44" Padding="20,0" />
                <Button Grid.Column="2" Text="Hide" Clicked="Hide_btn_Clicked" x:Name="hide"
                        CornerRadius="22" MinimumHeightRequest="44" Padding="16,0"
                        BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#344054}"
                        TextColor="{AppThemeBinding Light=#344054, Dark=#F2F4F7}"
                        IsVisible="{OnPlatform WinUI=true, Default=false}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
